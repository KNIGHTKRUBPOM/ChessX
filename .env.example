# Copy to .env.local and fill values for the local stack. Leave real credentials out of Git.
CHESS_ENV=local
CHESS_ROOM_STORE=supabase
CHESS_ACCOUNT_ENABLED=1
APP_ORIGIN=http://127.0.0.1:3210
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated enabled providers, for example google,facebook.
AUTH_OAUTH_PROVIDERS=
# Public Turnstile site key. Set the corresponding secret in Supabase, outside the frontend.
AUTH_CAPTCHA_SITE_KEY=

# Only for the local Supabase CLI when explicitly enabling OAuth in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Optional absolute executables for Windows or a custom virtual environment.
SUPABASE_CLI=
CHESS_PYTHON=
